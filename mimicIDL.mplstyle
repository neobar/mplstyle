# ============================================================
# IDL-like Matplotlib Style
# For scientific / astronomical plots
# ============================================================

# ------------------------------------------------------------
# Figure
# ------------------------------------------------------------
figure.figsize: 8, 6
figure.dpi: 100
figure.facecolor: white

# ------------------------------------------------------------
# Font
# ------------------------------------------------------------
font.family: serif
font.serif: Times New Roman, Times, STIXGeneral, DejaVu Serif

text.color: black
text.usetex: False

mathtext.fontset: stix
mathtext.default: it
mathtext.rm: STIXGeneral
mathtext.it: STIXGeneral:italic
mathtext.bf: STIXGeneral:bold
mathtext.cal: STIXGeneral
mathtext.sf: STIXSans
mathtext.tt: STIXGeneral

# ------------------------------------------------------------
# Axes
# ------------------------------------------------------------
axes.labelsize: 24
axes.titlesize: 22
axes.linewidth: 1.8
axes.edgecolor: black
axes.facecolor: white

axes.grid: False
axes.axisbelow: False

# IDL-like color cycle
axes.prop_cycle: cycler('color', ['000000', 'd62728', '1f77b4', '2ca02c', '9467bd', 'ff7f0e', '17becf', '8c564b'])

# ------------------------------------------------------------
# Lines and markers
# ------------------------------------------------------------
lines.linewidth: 2.2
lines.markersize: 8.5
lines.markeredgewidth: 1.3

patch.linewidth: 0.8
patch.edgecolor: black

# ------------------------------------------------------------
# Ticks
# ------------------------------------------------------------
xtick.direction: in
ytick.direction: in

xtick.top: True
ytick.right: True

xtick.labelsize: 18
ytick.labelsize: 18

xtick.major.size: 8
ytick.major.size: 8
xtick.minor.size: 4
ytick.minor.size: 4

xtick.major.width: 1.5
ytick.major.width: 1.5
xtick.minor.width: 1.2
ytick.minor.width: 1.2

xtick.major.pad: 8
ytick.major.pad: 8

xtick.color: black
ytick.color: black

# ------------------------------------------------------------
# Minor ticks
# ------------------------------------------------------------
xtick.minor.visible: True
ytick.minor.visible: True

# ------------------------------------------------------------
# Legend
# ------------------------------------------------------------
legend.fontsize: 19
legend.frameon: False
legend.numpoints: 1
legend.scatterpoints: 1
legend.loc: best
legend.handlelength: 1.8
legend.handletextpad: 0.4
legend.borderaxespad: 0.5
legend.labelspacing: 0.35

# ------------------------------------------------------------
# Grid
# ------------------------------------------------------------
grid.color: black
grid.linestyle: --
grid.linewidth: 0.8
grid.alpha: 0.35

# ------------------------------------------------------------
# Error bars
# ------------------------------------------------------------
errorbar.capsize: 0

# ------------------------------------------------------------
# Image display
# ------------------------------------------------------------
image.cmap: gray
image.origin: lower
image.interpolation: nearest

# ------------------------------------------------------------
# Savefig
# ------------------------------------------------------------
savefig.dpi: 150
savefig.bbox: tight
savefig.pad_inches: 0.05
savefig.transparent: False
savefig.facecolor: white
savefig.edgecolor: white

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none

# ------------------------------------------------------------
# Path simplification
# ------------------------------------------------------------
path.simplify: True
path.simplify_threshold: 0.111111
